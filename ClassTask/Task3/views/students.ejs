<%- include('partials/header') %>

<h2>All Students</h2>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Name</th>
      <th>Marks</th>
      <th>Grade</th>
      <th>Status</th>
      <th>Details</th>
    </tr>
  </thead>
  <tbody>
    <% students.forEach((student) => { %>
      <tr>
        <td><%= student.id %></td>
        <td><%= student.name %></td>
        <td><%= student.marks %></td>
        <td><%= student.grade %></td>
        <td>
          <% if (student.marks >= 40) { %>
            <span class="pass">Pass</span>
          <% } else { %>
            <span class="fail">Fail</span>
          <% } %>
        </td>
        <td><a href="/students/<%= student.id %>">View</a></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<a class="btn" href="/add-student">Add New Student</a>

<%- include('partials/footer') %>
